# Copy to .env.local to override. Vite only exposes variables prefixed with VITE_.
VITE_WS_URL=ws://localhost:8080
# Must match the server's AUTH_TOKEN when that is set. Visible to anyone who loads the page:
# a placeholder, not a secret (see docs/SECURITY.md).
VITE_WS_TOKEN=
# Frame buffer wait before posting to the worker, ms. 0 = no buffering (experiment baseline).
VITE_BUFFER_MS=50
