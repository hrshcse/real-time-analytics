# Copy to .env and adjust. All values are optional.
PORT=8080
# Events/sec when a client connects
DEFAULT_RATE=1000
# Hard ceiling for setRate / burst requests
MAX_RATE=100000
# How often a batch frame is sent (ms)
TICK_MS=50
# App-level heartbeat interval (ms)
HEARTBEAT_MS=5000
# Drop frames for a client when its unsent buffer exceeds this (bytes)
MAX_BUFFERED_BYTES=8388608
# Fault injection for testing validation: % of events that are invalid, % of frames that are not valid JSON
BAD_EVENT_PCT=0
BAD_FRAME_PCT=0
# Comma-separated allowed browser origins ("*" = allow any, dev only)
ALLOWED_ORIGINS=http://localhost:5173
